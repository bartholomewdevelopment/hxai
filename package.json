{
  "name": "historyai",
  "version": "0.1.0",
  "private": true,
  "description": "AI Historical Library \u2014 source-grounded conversations with historical figures.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm run build:shared",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @historyai/api",
    "dev:web": "npm run dev --workspace @historyai/web",
    "build:shared": "npm run build --workspace @historyai/shared",
    "build": "npm run build:shared && npm run build --workspace @historyai/api && npm run build --workspace @historyai/web",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace @historyai/api",
    "predb:migrate": "npm run build:shared",
    "db:migrate": "npm run db:migrate --workspace @historyai/api",
    "predb:seed": "npm run build:shared",
    "db:seed": "npm run db:seed --workspace @historyai/api",
    "db:studio": "npm run db:studio --workspace @historyai/api",
    "corpus:verify": "npm run build:shared && npm run corpus:verify --workspace @historyai/api --",
    "corpus:ingest": "npm run build:shared && npm run corpus:ingest --workspace @historyai/api --",
    "embed": "npm run build:shared && npm run embed --workspace @historyai/api --",
    "eval": "npm run build:shared && npm run eval --workspace @historyai/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
