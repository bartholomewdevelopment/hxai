# ---------------------------------------------------------------------------
# HistoryAI — environment configuration
# Copy to `.env` at the repo root: `cp .env.example .env`
# ---------------------------------------------------------------------------

# === REQUIRED FOR PHASE 1 ==================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres + pgvector. Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://historyai:historyai@localhost:5433/historyai

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Auth. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-in-every-real-environment
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Rate limiting (per window, per IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# Embedding dimensionality. Baked into the pgvector column at migration time —
# changing it later requires a migration + full re-embed. 1536 fits
# OpenAI text-embedding-3-small and Voyage voyage-3-lite.
EMBEDDING_DIMENSIONS=1536


# === NOT NEEDED IN PHASE 1 — required by later phases ======================
# Every service below has a stub implementation today. Providers are selected
# at runtime by the *_PROVIDER vars; leaving them as `stub` keeps Phase 1
# running with no third-party accounts and no keys.

# --- Phase 3: LLM (conversation generation). Claude is the default. --------
LLM_PROVIDER=stub                     # stub | anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5
# LLM_MAX_TOKENS=2048

# --- Phase 2: Embeddings (source chunk vectorization). Swappable. ----------
EMBEDDING_PROVIDER=stub               # stub | openai | voyage | cohere
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
# COHERE_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# --- Phase 3: Reranking (post-retrieval relevance ordering) ---------------
RERANKING_PROVIDER=stub               # stub | cohere | voyage

# --- Phase 2: Object storage (source scans, audio, video, portraits) ------
STORAGE_PROVIDER=stub                 # stub | s3 | r2
# STORAGE_BUCKET=historyai-sources
# STORAGE_REGION=auto
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com

# --- Phase 5: Voice (speech-to-text / text-to-speech) ---------------------
STT_PROVIDER=stub                     # stub | openai-whisper | deepgram
TTS_PROVIDER=stub                     # stub | elevenlabs | openai
# ELEVENLABS_API_KEY=
# DEEPGRAM_API_KEY=
